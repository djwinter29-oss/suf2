get_filename_component(SUF2_ESP32_DIR "${CMAKE_CURRENT_LIST_DIR}" REALPATH)
get_filename_component(SUF2_REPO_DIR "${SUF2_ESP32_DIR}/../../.." REALPATH)
set(SDKCONFIG "${CMAKE_BINARY_DIR}/sdkconfig" CACHE FILEPATH "Generated ESP-IDF configuration")
set(SDKCONFIG_DEFAULTS "${SUF2_ESP32_DIR}/sdkconfig.defaults" CACHE STRING "ESP-IDF defaults")
set(SUF2_PRODUCT_ID "53554632455350333253330000000000" CACHE STRING "Product ID as 32 hex digits")
set(SUF2_TRUSTED_KEYS "" CACHE STRING "Provisioned public PEM keys or certificates")
option(SUF2_PRODUCTION "Reject example keys and the development product ID" OFF)
set(SUF2_SIGNING_KEY "" CACHE FILEPATH "Development-only example signing key")
if (SUF2_PRODUCTION AND SUF2_SIGNING_KEY)
    message(FATAL_ERROR "SUF2_PRODUCTION requires --no-sign; sign releases offline")
endif()

string(TOLOWER "${SUF2_PRODUCT_ID}" SUF2_PRODUCT_ID)
string(LENGTH "${SUF2_PRODUCT_ID}" _length)
if (NOT _length EQUAL 32 OR NOT SUF2_PRODUCT_ID MATCHES "^[0-9a-f]+$")
    message(FATAL_ERROR "SUF2_PRODUCT_ID must contain exactly 32 hex digits")
endif()
if (SUF2_PRODUCTION AND SUF2_PRODUCT_ID STREQUAL "53554632455350333253330000000000")
    message(FATAL_ERROR "SUF2_PRODUCTION requires your own product ID")
endif()
string(REGEX REPLACE "(..)" "0x\\1, " SUF2_PRODUCT_ID_BYTES "${SUF2_PRODUCT_ID}")
set(SUF2_GENERATED_DIR "${CMAKE_BINARY_DIR}/generated")
configure_file("${SUF2_ESP32_DIR}/suf2_config.h.in" "${SUF2_GENERATED_DIR}/suf2_config.h")

find_package(Python3 REQUIRED COMPONENTS Interpreter)
set(_keys ${SUF2_TRUSTED_KEYS})
set(_key_args)
if (SUF2_PRODUCTION)
    if (NOT _keys)
        message(FATAL_ERROR "SUF2_PRODUCTION requires SUF2_TRUSTED_KEYS")
    endif()
    list(APPEND _key_args --production --forbid-dir "${SUF2_REPO_DIR}/test-keys"
        --forbid-dir "${SUF2_REPO_DIR}/host/shared")
elseif (NOT _keys)
    if (EXISTS "${SUF2_REPO_DIR}/test-keys/local/signing-public.pem")
        set(_keys "${SUF2_REPO_DIR}/test-keys/local/signing-public.pem")
    else()
        set(_keys "${SUF2_REPO_DIR}/test-keys/examples/signing-public.pem")
        message(WARNING "Using the example public key; generate local test keys to sign updates")
    endif()
endif()
execute_process(
    COMMAND ${Python3_EXECUTABLE} "${SUF2_REPO_DIR}/tools/firmware/suf2_keys_header.py"
        --output "${SUF2_GENERATED_DIR}/suf2_keys.h" ${_key_args} ${_keys}
    RESULT_VARIABLE _result ERROR_VARIABLE _error)
if (NOT _result EQUAL 0)
    message(FATAL_ERROR "Could not generate trusted keys:\n${_error}")
endif()
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
    "${SUF2_REPO_DIR}/tools/firmware/suf2_keys_header.py" ${_keys})
if (CMAKE_CURRENT_SOURCE_DIR STREQUAL "${SUF2_ESP32_DIR}/suf2-boot")
    include("${SUF2_REPO_DIR}/tools/firmware/suf2_decryption_keys.cmake")
endif()

function(suf2_esp32_validate_config)
    if (CMAKE_CURRENT_SOURCE_DIR STREQUAL "${SUF2_ESP32_DIR}/suf2-boot" AND
        CONFIG_ESP_MAIN_TASK_STACK_SIZE LESS 8192)
        message(FATAL_ERROR "AES verification requires CONFIG_ESP_MAIN_TASK_STACK_SIZE >= 8192; update sdkconfig or rebuild clean")
    endif()
    if (CONFIG_SECURE_BOOT OR CONFIG_SECURE_FLASH_ENC_ENABLED OR
        CONFIG_BOOTLOADER_SKIP_VALIDATE_IN_DEEP_SLEEP OR CONFIG_BOOTLOADER_SKIP_VALIDATE_ALWAYS OR
        CONFIG_BOOTLOADER_SKIP_VALIDATE_ON_POWER_ON OR CONFIG_BOOTLOADER_APP_TEST)
        message(FATAL_ERROR "This demo does not support automatic eFuse provisioning or boot-validation bypasses")
    endif()
    if (NOT CONFIG_PARTITION_TABLE_OFFSET EQUAL 0x20000 OR NOT CONFIG_ESPTOOLPY_FLASHSIZE_4MB)
        message(FATAL_ERROR "This demo requires its fixed partition layout and at least 4 MB flash")
    endif()
    if (NOT CONFIG_BOOTLOADER_CUSTOM_RESERVE_RTC OR NOT CONFIG_BOOTLOADER_CUSTOM_RESERVE_RTC_SIZE EQUAL 8 OR
        CONFIG_BOOTLOADER_CUSTOM_RESERVE_RTC_IN_CRC OR NOT CONFIG_ESP_MAIN_TASK_AFFINITY_CPU0)
        message(FATAL_ERROR "This demo requires the shared 8-byte custom RTC region, CRC exclusion and main task on CPU0")
    endif()
endfunction()
