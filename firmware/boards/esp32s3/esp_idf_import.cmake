include_guard(GLOBAL)

if (NOT DEFINED ENV{IDF_PATH})
    get_filename_component(_idf "${CMAKE_CURRENT_LIST_DIR}/../../lib/esp-idf" REALPATH)
    set(ENV{IDF_PATH} "${_idf}")
endif()
if (NOT EXISTS "$ENV{IDF_PATH}/tools/cmake/project.cmake")
    message(FATAL_ERROR "ESP-IDF is missing. Initialize firmware/lib/esp-idf and source its export.sh.")
endif()
set(IDF_TARGET esp32s3 CACHE STRING "ESP-IDF target")
if (NOT IDF_TARGET STREQUAL "esp32s3")
    message(FATAL_ERROR "This example supports ESP32-S3 only")
endif()
include("$ENV{IDF_PATH}/tools/cmake/project.cmake")
